# ==============================================================================
# Firebase Cloud Functions — Environment Variables
# ==============================================================================
# For Cloud Functions v2, place a `.env` file in the `functions/` directory.
# Firebase will automatically load these when deploying.
#
# For secrets (recommended for API keys), use Firebase Secret Manager:
#   firebase functions:secrets:set HK_API_KEY
#
# See: https://firebase.google.com/docs/functions/config-env
# ==============================================================================

# ── Hong Kong API Credentials (鲸舰 OpenAPI) ─────────────────────────────────
# ⚠️ STRICTLY SECRET — never expose to frontend or commit real values.
HK_API_APP_ID=8c9f2200a1834c6fb306682281e293e3
HK_API_KEY=9DAE66C101D801C51B1C8C5137B1F742
HK_API_BASE_URL=https://[REMOTE_API_DOMAIN]/openapi/action
HK_API_VERSION=11.7.1

# Note: Leave HK_API_BASE_URL empty or with placeholder to enable mock mode.
# Set it to the actual API endpoint for production:
#   e.g., https://api.example.com/openapi/action
