{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "JPOS",
    "version": "../package.json",
    "identifier": "com.jpos.system",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm card-reader:build && pnpm printer-drivers:verify && pnpm build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "title": "JPOS",
                "label": "main",
                "width": 1280,
                "height": 800,
                "resizable": true,
                "maximizable": true,
                "minimizable": true,
                "closable": true,
                "decorations": true,
                "maximized": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "createUpdaterArtifacts": true,
        "resources": [
            "resources/card-reader/*",
            "resources/printer-drivers/**/*"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "both",
                "installerHooks": "./windows/installer-hooks.nsh"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGODhFMUQ2QUYxMzc3RkIKUldUN2R4T3YxdUdJL3lHdmcrb1NPL3V4OEErMjlqanBQOTA3aVR4dVBUSVZFL3JyRGk2aEh2VjYK",
            "endpoints": [
                "https://github.com/machhoai/POS/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
