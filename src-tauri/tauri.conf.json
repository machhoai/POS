{
    "$schema": "https://raw.githubusercontent.com/nicegui/nicegui-native/refs/heads/main/nicegui_native/.tauri/config-schema.json",
    "productName": "JPOS",
    "version": "0.1.9",
    "identifier": "com.jpos.system",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devUrl": "http://localhost:3000",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "title": "JPOS",
                "label": "main",
                "width": 1280,
                "height": 800,
                "resizable": true,
                "maximizable": true,
                "minimizable": true,
                "closable": true,
                "decorations": true,
                "maximized": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}