rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // POS order reads and writes go through authenticated callable Functions.
    // The documents contain opaque invoice-request capability tokens, so direct
    // client access must stay disabled even for authenticated users.
    match /pos_orders/{orderId} {
      allow read, write: if false;
    }
  }
}
