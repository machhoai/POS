rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // POS order reads and writes go through authenticated callable Functions.
    // The documents contain opaque invoice-request capability tokens, so direct
    // client access must stay disabled even for authenticated users.
    match /pos_orders/{orderId} {
      allow read, write: if false;
    }

    // Payment settings are managed exclusively by authenticated callable
    // Functions so account changes receive warehouse-scoped RBAC checks.
    match /pos_payment_settings/{warehouseId} {
      allow read, write: if false;
    }

    // JPULSE manages trusted devices and shared receipt configuration through
    // authenticated backend APIs. JPOS never accesses these documents directly.
    match /pos_devices/{deviceId} {
      allow read, write: if false;
    }
    match /pos_device_enrollments/{enrollmentId} {
      allow read, write: if false;
    }
    match /pos_receipt_settings/{warehouseId} {
      allow read, write: if false;
    }
  }
}
